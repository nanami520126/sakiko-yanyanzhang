<!--pages/address-edit/address-edit.wxml-->
<navigation-bar title="新增地址" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="page">
  <view class="body">
    <view class="card">
      <view class="field">
        <text class="label">收货人</text>
        <input class="input" placeholder="姓名" value="{{form.consignee}}" data-field="consignee" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">手机号</text>
        <input class="input" type="number" placeholder="11 位手机号" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">性别</text>
        <view class="sex">
          <view class="sex-item {{form.sex === '1' ? 'on' : ''}}" data-value="1" bindtap="onSex">先生</view>
          <view class="sex-item {{form.sex === '0' ? 'on' : ''}}" data-value="0" bindtap="onSex">女士</view>
        </view>
      </view>
      <view class="field">
        <text class="label">所在地区</text>
        <picker mode="region" value="{{form.region}}" bindchange="onRegion">
          <view class="region">{{form.region[0]}} {{form.region[1]}} {{form.region[2]}} ›</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">详细地址</text>
        <input class="input" placeholder="街道、门牌号等" value="{{form.detail}}" data-field="detail" bindinput="onInput" />
      </view>
      <view class="field">
        <text class="label">标签</text>
        <input class="input" placeholder="家 / 公司 / 学校（选填）" value="{{form.label}}" data-field="label" bindinput="onInput" />
      </view>
    </view>
  </view>

  <view class="footer">
    <view class="save-btn" bindtap="save">保存</view>
  </view>
</view>
