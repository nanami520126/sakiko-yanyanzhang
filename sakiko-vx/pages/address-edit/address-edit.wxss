/* pages/address-edit/address-edit.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}
.body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 24rpx 140rpx;
  box-sizing: border-box;
}
.card {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
}
.field {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid var(--hairline);
}
.field:last-child {
  border-bottom: none;
}
.label {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--ink);
}
.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.sex {
  display: flex;
  gap: 20rpx;
}
.sex-item {
  padding: 10rpx 32rpx;
  border-radius: 999rpx;
  background: var(--paper);
  color: var(--muted);
  font-size: 26rpx;
}
.sex-item.on {
  background: rgba(194, 58, 46, 0.08);
  color: var(--cinnabar);
  border: 1rpx solid var(--cinnabar);
}
.region {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx;
  background: var(--surface);
  border-top: 1rpx solid var(--hairline);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.save-btn {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: var(--cinnabar);
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
}
