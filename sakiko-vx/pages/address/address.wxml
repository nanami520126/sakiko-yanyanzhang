<!--pages/address/address.wxml-->
<navigation-bar title="收货地址" back="{{true}}" color="black" background="#FFF"></navigation-bar>

<view class="page">
  <view class="body">
    <view class="addr-card" wx:for="{{list}}" wx:key="id" data-index="{{index}}" bindtap="selectAddress">
      <view class="addr-main">
        <view class="addr-top">
          <text class="addr-name">{{item.consignee}}</text>
          <text class="addr-phone">{{item.phone}}</text>
          <view class="badge" wx:if="{{item.isDefault === 1}}">默认</view>
        </view>
        <view class="addr-detail">{{item.provinceName}}{{item.cityName}}{{item.districtName}}{{item.detail}}</view>
      </view>
      <view class="addr-actions">
        <view class="act" data-index="{{index}}" catchtap="setDefault" wx:if="{{item.isDefault !== 1}}">设为默认</view>
        <view class="act" data-index="{{index}}" catchtap="editAddress">编辑</view>
        <view class="act del" data-index="{{index}}" catchtap="deleteAddress">删除</view>
      </view>
    </view>
    <view class="empty" wx:if="{{list.length === 0}}">还没有收货地址</view>
  </view>

  <view class="footer">
    <view class="add-btn" bindtap="addAddress">＋ 新增收货地址</view>
  </view>
</view>
