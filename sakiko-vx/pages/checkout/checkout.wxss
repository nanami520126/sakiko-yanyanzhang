/* pages/checkout/checkout.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}
.body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 24rpx 140rpx;
  box-sizing: border-box;
}
.card {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}

/* 地址 */
.addr-top {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.addr-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.addr-phone {
  font-size: 26rpx;
  color: var(--muted);
}
.addr-detail {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.5;
}
.addr-empty {
  font-size: 30rpx;
  color: var(--muted);
}
.addr-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--muted);
  font-size: 40rpx;
}
.card[bindtap] {
  position: relative;
}

/* 商品 */
.item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.item:last-child {
  border-bottom: none;
}
.item-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--paper);
}
.item-info {
  flex: 1;
  min-width: 0;
}
.item-name {
  font-size: 28rpx;
  color: var(--ink);
}
.item-flavor {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}
.item-right {
  text-align: right;
}
.item-price {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--cinnabar);
}
.item-num {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* 备注 */
.remark {
  width: 100%;
  font-size: 26rpx;
  color: var(--ink);
}

/* 金额 */
.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--ink);
}
.row.total {
  border-top: 1rpx solid var(--hairline);
  margin-top: 8rpx;
  padding-top: 20rpx;
}
.total-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--cinnabar);
}

/* 底部 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  background: var(--surface);
  border-top: 1rpx solid var(--hairline);
  padding-bottom: env(safe-area-inset-bottom);
}
.footer-total {
  flex: 1;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding-left: 28rpx;
}
.footer-total .label {
  font-size: 26rpx;
  color: var(--ink);
}
.footer-total .amount {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--cinnabar);
}
.submit-btn {
  height: 100rpx;
  line-height: 100rpx;
  padding: 0 56rpx;
  background: var(--cinnabar);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
