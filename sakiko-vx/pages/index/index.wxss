/* pages/index/index.wxss */
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}

/* —— 顶部 —— */
.header {
  background: var(--paper);
}
.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 24rpx;
}
.brand {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: var(--ink);
}
.status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}
.status .dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}
.status.open {
  color: var(--bamboo);
  background: rgba(107, 142, 78, 0.12);
}
.status.open .dot {
  background: var(--bamboo);
}
.status.closed {
  color: var(--muted);
  background: rgba(154, 145, 132, 0.14);
}
.status.closed .dot {
  background: var(--muted);
}

/* —— 主体：左分类 + 右列表 —— */
.body {
  flex: 1;
  display: flex;
  overflow: hidden;
  border-top: 1rpx solid var(--hairline);
}

.rail {
  width: 172rpx;
  flex-shrink: 0;
  height: 100%;
  background: var(--paper);
}
.rail-item {
  position: relative;
  padding: 30rpx 16rpx 30rpx 28rpx;
  font-size: 27rpx;
  color: var(--muted);
  line-height: 1.3;
}
.rail-item.active {
  color: var(--ink);
  font-weight: 600;
  background: var(--surface);
}
.rail-bar {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 40rpx;
  border-radius: 0 8rpx 8rpx 0;
  background: transparent;
}
.rail-item.active .rail-bar {
  background: var(--cinnabar);
}
.rail-tag {
  display: inline-block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--cinnabar);
  border: 1rpx solid var(--cinnabar);
  border-radius: 6rpx;
  padding: 0 8rpx;
}

.list {
  flex: 1;
  height: 100%;
  background: var(--surface);
}
.food {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 24rpx 24rpx 0;
  margin-left: 24rpx;
  border-bottom: 1rpx solid var(--hairline);
}
.food:last-child {
  border-bottom: none;
}
.food-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--paper);
}
.food-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.food-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.food-desc {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.food-bottom {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.price {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--cinnabar);
}
.add {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--cinnabar);
  color: #fff;
  font-size: 34rpx;
  text-align: center;
  line-height: 48rpx;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

/* —— 底部购物车条 —— */
.cartbar {
  flex-shrink: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  background: var(--surface);
  border-top: 1rpx solid var(--hairline);
  box-shadow: 0 -4rpx 20rpx rgba(43, 40, 37, 0.04);
}
.cart-left {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-left: 28rpx;
}
.cart-icon {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--paper);
}
.cart-icon::before {
  content: '🛒';
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--cinnabar);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  line-height: 32rpx;
}
.cart-total {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}
.checkout {
  height: 100rpx;
  line-height: 100rpx;
  padding: 0 48rpx;
  background: var(--cinnabar);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* —— 遮罩 —— */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(43, 40, 37, 0.5);
  z-index: 10;
}

/* —— 详情弹窗 —— */
.popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 20;
  padding-bottom: env(safe-area-inset-bottom);
}
.popup-body {
  /* 高度由内联 style（popupBodyHeight）控制，保证 skyline 下可滚动 */
}
.popup-img {
  width: 100%;
  height: 360rpx;
  background: var(--paper);
}
.popup-info {
  padding: 28rpx 32rpx;
}
.popup-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}
.popup-desc {
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 10rpx;
}
.flavor-group {
  margin-top: 26rpx;
}
.flavor-name {
  font-size: 26rpx;
  color: var(--muted);
  margin-bottom: 14rpx;
}
.flavor-empty {
  margin-top: 26rpx;
  font-size: 26rpx;
  color: var(--muted);
}
.flavor-opts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--paper);
  color: var(--ink);
  font-size: 26rpx;
  border: 1rpx solid transparent;
}
.chip-active {
  background: rgba(194, 58, 46, 0.08);
  color: var(--cinnabar);
  border-color: var(--cinnabar);
}
.setmeal-dishes {
  margin-top: 26rpx;
}
.sd-item {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--hairline);
  font-size: 27rpx;
}
.sd-copies {
  color: var(--muted);
}
.popup-footer {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
  border-top: 1rpx solid var(--hairline);
}
.popup-price {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--cinnabar);
}
.add-cart {
  padding: 20rpx 56rpx;
  background: var(--cinnabar);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  letter-spacing: 2rpx;
}

/* —— 购物车弹层 —— */
.cart-popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--surface);
  border-radius: 32rpx 32rpx 0 0;
  z-index: 20;
  padding-bottom: env(safe-area-inset-bottom);
}
.cart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 16rpx;
}
.cart-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.cart-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.cart-clear {
  font-size: 26rpx;
  color: var(--muted);
  padding: 8rpx 16rpx;
}
.cart-close {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--paper);
  color: var(--ink);
  font-size: 32rpx;
  text-align: center;
  line-height: 52rpx;
}
.cart-list {
  padding: 0 32rpx 32rpx;
  box-sizing: border-box;
}
.cart-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.cart-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--paper);
}
.cart-info {
  flex: 1;
  min-width: 0;
}
.cart-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
.cart-flavor {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}
.cart-price {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--cinnabar);
  margin-top: 6rpx;
}
.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.step-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 1rpx solid var(--hairline);
  color: var(--ink);
  text-align: center;
  line-height: 46rpx;
  font-size: 28rpx;
}
.step-btn.plus {
  background: var(--cinnabar);
  color: #fff;
  border-color: var(--cinnabar);
}
.step-num {
  min-width: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--ink);
}

/* —— 登录弹窗 —— */
.login-popup {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  background: var(--surface);
  border-radius: 32rpx;
  z-index: 20;
  padding: 56rpx 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.login-brand {
  font-size: 52rpx;
  font-weight: 700;
  color: var(--cinnabar);
  letter-spacing: 4rpx;
}
.login-title {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--muted);
}
.login-btn {
  margin-top: 48rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: var(--cinnabar);
  color: #fff;
  font-size: 30rpx;
  border-radius: 999rpx;
  text-align: center;
}
.login-skip {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: var(--muted);
  padding: 8rpx 24rpx;
}

/* —— 底部导航 —— */
.tabbar {
  flex-shrink: 0;
  display: flex;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  background: var(--paper);
  border-top: 1rpx solid var(--hairline);
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tab-text {
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: var(--muted);
  line-height: 1;
}
.tab-mark {
  margin-top: 10rpx;
  width: 36rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: transparent;
}
.tab-item.active .tab-text {
  color: var(--ink);
  font-weight: 600;
}
.tab-item.active .tab-mark {
  background: var(--cinnabar);
}
