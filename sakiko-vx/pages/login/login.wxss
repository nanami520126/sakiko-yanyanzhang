/* pages/login/login.wxss */
page {
  height: 100vh;
  background: linear-gradient(160deg, #a8d8ea 0%, #eaf6ef 100%);
}

.login-page {
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.login-box {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  line-height: 160rpx;
  text-align: center;
  border-radius: 50%;
  background: #52c41a;
  color: #fff;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.title {
  color: #333;
  font-size: 32rpx;
  margin-bottom: 80rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: #52c41a;
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  border: none;
}

.login-btn::after {
  border: none;
}
