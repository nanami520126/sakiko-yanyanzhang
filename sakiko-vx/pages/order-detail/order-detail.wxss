/* pages/order-detail/order-detail.wxss */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}
.body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 24rpx 160rpx;
  box-sizing: border-box;
}

/* 状态 */
.status-card {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.status-text {
  font-size: 36rpx;
  font-weight: 700;
}
.status-sub {
  font-size: 24rpx;
  color: var(--muted);
}
.status-card.wait .status-text {
  color: var(--cinnabar);
}
.status-card.process .status-text,
.status-card.done .status-text {
  color: var(--bamboo);
}
.status-card.cancelled .status-text {
  color: var(--muted);
}

/* 卡片 */
.card {
  background: var(--surface);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}

/* 收货信息 */
.addr-top {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.addr-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.addr-phone {
  font-size: 26rpx;
  color: var(--muted);
}
.addr-detail {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ink);
  line-height: 1.5;
}

/* 商品 */
.item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--hairline);
}
.item:last-child {
  border-bottom: none;
}
.item-img {
  width: 88rpx;
  height: 88rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--paper);
}
.item-info {
  flex: 1;
  min-width: 0;
}
.item-name {
  font-size: 28rpx;
  color: var(--ink);
}
.item-flavor {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}
.item-right {
  text-align: right;
}
.item-price {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--cinnabar);
}
.item-num {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* 金额 / 订单信息 */
.row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: var(--ink);
  word-break: break-all;
}
.row.total {
  border-top: 1rpx solid var(--hairline);
  margin-top: 8rpx;
  padding-top: 20rpx;
}
.total-price {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--cinnabar);
}

.empty {
  padding: 40rpx 0;
  text-align: center;
  color: var(--muted);
  font-size: 26rpx;
}

/* 底部操作 */
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: var(--surface);
  border-top: 1rpx solid var(--hairline);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.btn {
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  text-align: center;
}
.btn.ghost {
  color: var(--ink);
  border: 1rpx solid var(--hairline);
  background: var(--surface);
}
.btn.primary {
  background: var(--cinnabar);
  color: #fff;
}
