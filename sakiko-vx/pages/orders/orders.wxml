<!--pages/orders/orders.wxml-->
<view class="page">
  <view class="header">
    <view class="statusbar" style="height:{{statusBarHeight}}px"></view>
    <view class="header-inner">
      <view class="title serif">我的订单</view>
    </view>
  </view>

  <!-- 状态筛选 -->
  <scroll-view class="tabs" scroll-x>
    <view
      wx:for="{{tabs}}"
      wx:key="label"
      class="tab {{activeTab === index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >{{item.label}}</view>
  </scroll-view>

  <!-- 列表 -->
  <view class="body">
    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="openDetail"
    >
      <view class="oc-head">
        <view class="oc-time">{{item.orderTime}}</view>
        <view class="oc-status {{item.statusCls}}">{{item.statusText}}</view>
      </view>
      <view class="oc-dishes serif">{{item.orderDishes}}</view>
      <view class="oc-foot">
        <view class="oc-amount serif">¥{{item.amount}}</view>
        <view class="oc-actions">
          <view class="btn ghost" wx:if="{{item.canCancel}}" data-id="{{item.id}}" catchtap="cancelOrder">取消订单</view>
          <view class="btn primary" wx:if="{{item.canRepetition}}" data-id="{{item.id}}" catchtap="repetition">再来一单</view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{loading}}">加载中…</view>
    <view class="empty" wx:if="{{!loading && orders.length === 0 && !needLogin}}">暂无相关订单</view>
    <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">加载更多</view>
    <view class="empty" wx:if="{{!hasMore && orders.length > 0}}">没有更多了</view>

    <!-- 未登录 -->
    <view class="empty" wx:if="{{needLogin}}">
      <view>登录后即可查看订单</view>
      <button class="btn primary login-btn" bindtap="doLogin" loading="{{loggingIn}}">微信一键登录</button>
    </view>
  </view>

  <!-- 底部导航 -->
  <view class="tabbar">
    <view class="tab-item {{tab === 'index' ? 'active' : ''}}" data-path="/pages/index/index" bindtap="onTabTap">
      <text class="tab-text">点餐</text>
      <view class="tab-mark"></view>
    </view>
    <view class="tab-item {{tab === 'orders' ? 'active' : ''}}" data-path="/pages/orders/orders" bindtap="onTabTap">
      <text class="tab-text">订单</text>
      <view class="tab-mark"></view>
    </view>
  </view>
</view>
